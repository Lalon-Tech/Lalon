rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user has administrative or staff authority
    function isAdminOrStaff() {
      return isAuthenticated() && (
        request.auth.token.email in ['admin@bondhusomiti.com', 'sin4.riyas.lalon.dc@gmail.com', 'lalon2711@gmail.com'] ||
        (exists(/databases/$(database)/documents/systemUsers/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/systemUsers/$(request.auth.uid)).data.role in ['admin', 'president', 'secretary', 'cashier', 'manager', 'field_officer'])
      );
    }

    // 0. Connection validation
    match /test/{docId} {
      allow read: if true;
    }

    // 1. Settings collection (Somiti organization configuration)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 2. System Users (Staff, Members, Admin)
    // Read is allowed to resolve login by Email or User UID
    // Creation and updates require authentication
    match /systemUsers/{userId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 3. Bank Accounts (Bank ledger & balances)
    match /bankAccounts/{accountId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 4. Income & Expense Vouchers (Ledger records)
    match /incomeExpenses/{voucherId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 5. Dashboard Summary
    match /dashboardSummary/{summaryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 6. Members Profile & Information
    match /members/{memberId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 7. Member Financials
    match /memberFinancials/{memberId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 8. Loans & Installment Schedules
    match /loans/{loanId} {
      allow read: if true;
      
      allow create: if isAuthenticated() && (
        isAdminOrStaff() ||
        (
          request.resource.data.status == 'pending' &&
          (
            request.resource.data.userId == request.auth.uid ||
            request.resource.data.applicantUid == request.auth.uid ||
            request.resource.data.memberId == request.auth.uid ||
            (exists(/databases/$(database)/documents/systemUsers/$(request.auth.uid)) &&
             request.resource.data.memberId == get(/databases/$(database)/documents/systemUsers/$(request.auth.uid)).data.memberId)
          )
        )
      );

      allow update, delete: if isAuthenticated() && (
        isAdminOrStaff() ||
        (
          resource.data.status == 'pending' &&
          (
            resource.data.userId == request.auth.uid ||
            resource.data.applicantUid == request.auth.uid ||
            resource.data.memberId == request.auth.uid ||
            (exists(/databases/$(database)/documents/systemUsers/$(request.auth.uid)) &&
             resource.data.memberId == get(/databases/$(database)/documents/systemUsers/$(request.auth.uid)).data.memberId)
          )
        )
      );
    }

    // 9. Savings & DPS / FDR Accounts
    match /savings/{savingsId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 10. Transactions (Deposits, Withdrawals, Installments, Expenses)
    match /transactions/{txId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 11. Share Closures & Surrender Archives
    match /shareClosures/{closureId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 12. Business Fundings & Applications
    match /businessFundings/{fundingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 13. Business Profit Records
    match /businessProfitRecords/{recordId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 14. Monthly Profit Distributions
    match /profitDistributions/{distId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 15. Member Numbers uniqueness registry (Database-level uniqueness validation)
    match /memberNumbers/{memberNo} {
      allow read: if true;
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/memberNumbers/$(memberNo));
      allow update, delete: if isAuthenticated() && isAdminOrStaff();
    }

    // 16. Counters
    match /counters/{counterId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Default fallback - allow read, require authentication for write
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

